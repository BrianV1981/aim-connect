# ==========================================
# A.I.M. CONNECT - ENVIRONMENT VARIABLES
# ==========================================

# (Required for Ngrok Tunnel)
# Revoke your old token and get a new one from dashboard.ngrok.com
NGROK_AUTHTOKEN="your_ngrok_authtoken_here"

# (Optional) Set a static Ngrok domain (e.g. your-name.ngrok-free.dev)
# If left blank, ngrok will assign a random ephemeral URL.
NGROK_DOMAIN=""

# (Optional) Define the absolute path for the Web IDE Workspace.
# Defaults to the user's home directory (~) if omitted.
AIM_WORKSPACE="/home/user/my-projects"

# (Optional) Comma-separated list of allowed CORS origins for the FastAPI backend.
# Defaults to "*" (allow all) which is acceptable if running behind a secure Ngrok tunnel.
# For production, set this to your actual domain(s):
# CORS_ORIGINS="https://your-domain.com,https://app.leaddeeds.com"
CORS_ORIGINS="*"
ALLOWED_IPS="" # Optional: Comma-separated list of allowed IP addresses

# ==========================================
# SECURITY
# ==========================================
# End-to-End Encryption for WebSocket traffic
ENABLE_E2EE=true
E2EE_SECRET="generate-a-strong-random-secret-here"

# HMAC signing secret for LeadDeed dashboard JWTs
LEADDEED_DOWNLOAD_SIGNING_SECRET="aim_connect_generate-a-64-char-hex-string-here"

# Token time-to-live in seconds (default: 14400 = 4 hours)
# TOKEN_TTL=14400

# Set to "true" to allow HTTP connections (NOT recommended for production).
# By default, non-localhost HTTP requests are rejected to enforce HTTPS.
# ALLOW_HTTP=false

# ==========================================
# WEBAUTHN
# ==========================================
# Relying Party ID for WebAuthn (must match your domain)
# WEBAUTHN_RP_ID="leaddeeds.com"

# ==========================================
# PWA THEMING (Multiple Phone Apps)
# ==========================================
# Change these values to uniquely identify this server when adding to your phone's Home Screen
AIM_APP_NAME="A.I.M. Connect"
AIM_APP_COLOR="#0B162C"
