# ==========================================
# A.I.M. CONNECT - ENVIRONMENT VARIABLES
# ==========================================

# (Required for Ngrok Tunnel)
# Revoke your old token and get a new one from dashboard.ngrok.com
NGROK_AUTHTOKEN="your_ngrok_authtoken_here"

# (Optional) Set a static Ngrok domain (e.g. your-name.ngrok-free.dev)
# If left blank, ngrok will assign a random ephemeral URL.
NGROK_DOMAIN=""

# (Optional) Define the absolute path for the Web IDE Workspace.
# Defaults to the project workspace/ directory if omitted.
AIM_WORKSPACE="workspace/"

# (Optional) Comma-separated list of allowed CORS origins for the FastAPI backend.
# Defaults to "*" (allow all) which is acceptable if running behind a secure Ngrok tunnel.
# For production, set this to your actual domain(s):
# CORS_ORIGINS="https://your-domain.com,https://app.example.com"
CORS_ORIGINS="*"
ALLOWED_IPS="" # Optional: Comma-separated list of allowed IP addresses

# ==========================================
# SECURITY
# ==========================================
# End-to-End Encryption for WebSocket traffic (set ENABLE_E2EE=true and a shared secret to enable)
ENABLE_E2EE=false
E2EE_SECRET=""

# HMAC signing secret for external dashboard magic-link JWTs
LEADDEED_DOWNLOAD_SIGNING_SECRET="aim_connect_generate-a-64-char-hex-string-here"

# Sandbox SMTP — injected into every customer bwrap sandbox (#186).
# Never commit the password.
# LEADDEED_SMTP_HOST="smtp.example.com"
# LEADDEED_SMTP_PORT="587"
# LEADDEED_SMTP_USER="noreply@example.com"
# LEADDEED_SMTP_PASS=""
# LEADDEED_SMTP_SECURE="false"
# LEADDEED_MAIL_FROM="Agent <noreply@example.com>"

# Token time-to-live in seconds (default: 14400 = 4 hours)
# TOKEN_TTL=14400

# Set to "true" to allow HTTP connections (NOT recommended for production).
# By default, non-localhost HTTP requests are rejected to enforce HTTPS.
# ALLOW_HTTP=false

# ==========================================
# WEBAUTHN
# ==========================================
# Relying Party ID for WebAuthn (optional; defaults to incoming request hostname)
# WEBAUTHN_RP_ID="your-domain.com"

# ==========================================
# PWA THEMING (Multiple Phone Apps)
# ==========================================
# Change these values to uniquely identify this server when adding to your phone's Home Screen
AIM_APP_NAME="A.I.M. Connect"
AIM_APP_COLOR="#0B162C"

# ==========================================
# OPTIONAL INTEGRATIONS (MCP / CLOUDFLARED)
# ==========================================
# Optional paths for sister MCP server, Cloudflared config, and public display URLs:
# AIM_MCP_DIR="$HOME/aim-mcp"
# CLOUDFLARED_BIN="$HOME/.local/bin/cloudflared"
# CLOUDFLARED_CONFIG="$HOME/.cloudflared/config.yml"
# AIM_PUBLIC_URL="https://api.yourdomain.com"
# AIM_MCP_PUBLIC_URL="https://mcp.yourdomain.com/sse"
# AIM_LD_SCRIPTS="$HOME/aim-ld/scripts"
