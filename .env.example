# ==========================================
# A.I.M. CONNECT - ENVIRONMENT VARIABLES
# ==========================================

# (Required for Ngrok Tunnel)
# Revoke your old token and get a new one from dashboard.ngrok.com
NGROK_AUTHTOKEN="your_ngrok_authtoken_here"

# (Optional) Set a static Ngrok domain (e.g. your-name.ngrok-free.dev)
# If left blank, ngrok will assign a random ephemeral URL.
NGROK_DOMAIN=""

# (Optional) Define the absolute path for the Web IDE Workspace.
# Defaults to the project workspace/ directory if omitted.
AIM_WORKSPACE="workspace/"

# (Optional) Comma-separated list of allowed CORS origins for the FastAPI backend.
# Defaults to "*" (allow all) which is acceptable if running behind a secure Ngrok tunnel.
# For production, set this to your actual domain(s):
# CORS_ORIGINS="https://your-domain.com,https://app.example.com"
CORS_ORIGINS="*"
ALLOWED_IPS="" # Optional: Comma-separated list of allowed IP addresses

# ==========================================
# SECURITY
# ==========================================
# End-to-End Encryption for WebSocket traffic (set ENABLE_E2EE=true and a shared secret to enable)
ENABLE_E2EE=false
E2EE_SECRET=""

# HMAC signing secret for external dashboard magic-link JWTs & sandbox relay tokens
# (Legacy alias LEADDEED_DOWNLOAD_SIGNING_SECRET is also supported for backward compatibility)
AIM_GATEWAY_SIGNING_SECRET="aim_connect_generate-a-64-char-hex-string-here"

# Host-only SMTP relay credentials (used by loopback /api/sandbox/email-relay; never injected into bwrap, #233/#238).
# Legacy aliases LEADDEED_SMTP_* and LEADDEED_MAIL_FROM are also supported. Never commit the password.
# AIM_SMTP_HOST="smtp.example.com"
# AIM_SMTP_PORT="587"
# AIM_SMTP_USER="noreply@example.com"
# AIM_SMTP_PASS=""
# AIM_SMTP_SECURE="false"
# AIM_MAIL_FROM="Agent <noreply@example.com>"

# Token time-to-live in seconds (default: 14400 = 4 hours)
# TOKEN_TTL=14400

# Set to "true" to allow HTTP connections on trusted private networks (e.g. Tailscale/WireGuard 100.x.x.x or local Docker).
# By default, non-localhost HTTP requests without X-Forwarded-Proto: https are rejected to enforce HTTPS.
# ALLOW_HTTP=false

# (Optional) Host interface IP bound by docker-compose.yml (defaults to 127.0.0.1 for safe localhost/reverse-proxy access; set to your Tailscale IP or 0.0.0.0 when needed).
# AIM_BIND_HOST="127.0.0.1"

# (Optional) Directory for 3FA hashes, totp.secret, tokens.json, users.json, and webauthn.json (defaults to backend/; set to /app/auth_data in Docker).
# AIM_AUTH_DIR=""

# (Optional) Shared secret for local host sister services (e.g. aim-office) calling loopback telemetry (/api/fleet/panes, /api/swarm/activity) via X-AIM-Loopback-Token.
# Auto-generated at 0600 backend/loopback.token when omitted.
# AIM_LOOPBACK_TOKEN=""

# ==========================================
# WEBAUTHN
# ==========================================
# Relying Party ID for WebAuthn (optional; defaults to incoming request hostname)
# WEBAUTHN_RP_ID="your-domain.com"

# ==========================================
# PWA THEMING & MULTI-SERVER FLEET (#306)
# ==========================================
# Uniquely identify this server on the 3FA Lock Screen, Cockpit Header, and Phone Home Screen icon:
AIM_APP_NAME="A.I.M. Connect"
AIM_APP_COLOR="#00FFA3"
# AIM_NODE_LABEL="WORKSTATION"
# AIM_APP_MONOGRAM="WS"
# Optional comma-separated peer AIM-Connect servers ("Label|https://host|#HexColor"):
# AIM_PEER_SERVERS="Workstation|https://aim.example.com|#00FFA3,Cloud VPS|https://vps.example.com|#38BDF8"

# ==========================================
# OPTIONAL INTEGRATIONS (MCP / CLOUDFLARED)
# ==========================================
# Optional paths for sister MCP server, Cloudflared config, and public display URLs:
# AIM_MCP_DIR="$HOME/aim-mcp"
# CLOUDFLARED_BIN="$HOME/.local/bin/cloudflared"
# CLOUDFLARED_CONFIG="$HOME/.cloudflared/config.yml"
# AIM_PUBLIC_URL="https://api.yourdomain.com"
# AIM_MCP_PUBLIC_URL="https://mcp.yourdomain.com/sse"
# AIM_LD_SCRIPTS="$HOME/aim-ld/scripts"
